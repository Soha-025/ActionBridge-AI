AWS_REGION=us-east-1
# Use a Claude model ID that supports tool use and that you enabled in Bedrock > Model access
BEDROCK_MODEL_ID=
DEMO_TODAY=2026-10-26
DB_PATH=actionbridge.db

# Provider selection (explicit only; never auto-switched on API failure).
# Precedence: DEMO_FALLBACK=true > LLM_PROVIDER=gemini > Bedrock (default).
# LLM_PROVIDER=gemini   # use the live Gemini demo LLM
# GEMINI_API_KEY=      # never commit; obtain from https://aistudio.google.com
# GEMINI_MODEL=gemini-3.8-flash   # tool-capable default; override if desired
# DEMO_FALLBACK=true     # deterministic offline emergency fallback (no LLM calls)
