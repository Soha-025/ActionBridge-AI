# ActionBridge backend environment.
# Copy to backend/.env (git-ignored). There are NO secrets in this file.
# Leave a section commented unless you actually need it.

# --- Database ---
DB_PATH=actionbridge.db

# --- Provider selection (explicit only; never auto-switched on API failure) ---
# Precedence: DEMO_FALLBACK=true  >  LLM_PROVIDER=gemini  >  Bedrock (default).

# A) Recommended no-key reviewer / offline demo mode (no Gemini key, no AWS):
# DEMO_FALLBACK=true

# B) Optional live Gemini (requires an API key; never commit it):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=            # a tool-capable Gemini model id

# C) Amazon Bedrock (used when A and B are unset; needs standard Boto3 credentials):
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=          # a tool-capable model enabled in your Bedrock account

# --- Optional, controlled service-level testing only ---
# Fixes the reference date used by services._today() for deterministic tests.
# Leave UNSET for normal use. Demo Mode always uses the real current system date
# and does NOT read this value.
# DEMO_TODAY=YYYY-MM-DD
